BASE_DIR = os.path.dirname(os.path.abspath(__file__))
DB_PATH  = os.path.join(BASE_DIR, 'database.db')


# HÀM TIỆN ÍCH – CƠ SỞ DỮ LIỆU
def get_db():
    conn = sqlite3.connect(DB_PATH)
    conn.row_factory = sqlite3.Row
    conn.execute("PRAGMA foreign_keys = ON")   # Bật khoá ngoại
    return conn


def init_db():
    """Khởi tạo tất cả bảng nếu chưa tồn tại."""
    conn = get_db()
    cur  = conn.cursor()
    cur.executescript("""
        CREATE TABLE IF NOT EXISTS users (
            id          INTEGER PRIMARY KEY AUTOINCREMENT,
            ten         TEXT    NOT NULL,
            email       TEXT    NOT NULL UNIQUE,
            mat_khau    TEXT    NOT NULL,
            ngay_tao    TEXT    DEFAULT (date('now'))
        );

        CREATE TABLE IF NOT EXISTS projects (
            id              INTEGER PRIMARY KEY AUTOINCREMENT,
            ten_du_an       TEXT    NOT NULL,
            mo_ta           TEXT,
            nguoi_tao       INTEGER NOT NULL,
            ngay_bat_dau    TEXT,
            ngay_ket_thuc   TEXT,
            ngay_tao        TEXT    DEFAULT (date('now')),
            FOREIGN KEY (nguoi_tao) REFERENCES users(id)
        );

        CREATE TABLE IF NOT EXISTS tasks (
            id              INTEGER PRIMARY KEY AUTOINCREMENT,
            ten_nhiem_vu    TEXT    NOT NULL,
            mo_ta           TEXT,
            du_an_id        INTEGER NOT NULL,
            phu_trach       INTEGER,
            deadline        TEXT,
            trang_thai      TEXT    DEFAULT 'chua_lam'
                            CHECK (trang_thai IN ('chua_lam','dang_lam','xong')),
            ngay_tao        TEXT    DEFAULT (date('now')),
            FOREIGN KEY (du_an_id)  REFERENCES projects(id) ON DELETE CASCADE,
            FOREIGN KEY (phu_trach) REFERENCES users(id)
        );
    """)
    conn.commit()
    conn.close()


# DECORATOR – YÊU CẦU ĐĂNG NHẬP
def login_required(f):
    @wraps(f)
    def decorated(*args, **kwargs):
        if 'user_id' not in session:
            flash('Vui long dang nhap de tiep tuc.', 'warning')
            return redirect(url_for('login'))
        return f(*args, **kwargs)
    return decorated


# HÀM HELPER – LẤY DỮ LIỆU THƯỜNG DÙNG
def get_all_users():
    conn = get_db()
    users = conn.execute("SELECT id, ten, email FROM users ORDER BY ten").fetchall()
    conn.close()
    return users

def get_all_projects():
    conn = get_db()
    projects = conn.execute(
        "SELECT id, ten_du_an FROM projects ORDER BY ten_du_an"
    ).fetchall()
    conn.close()
    return projects

def get_project_or_404(project_id):
    """Lấy dự án theo ID, trả None nếu không tồn tại."""
    conn = get_db()
    p = conn.execute("SELECT * FROM projects WHERE id = ?", (project_id,)).fetchone()
    conn.close()
    return p

def get_task_or_404(task_id):
    conn = get_db()
    t = conn.execute("SELECT * FROM tasks WHERE id = ?", (task_id,)).fetchone()
    conn.close()
    return t


