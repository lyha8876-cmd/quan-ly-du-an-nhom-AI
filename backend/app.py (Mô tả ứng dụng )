    """Form thêm dự án mới."""
    if request.method == 'POST':
        ten_du_an     = request.form.get('ten_du_an', '').strip()
        mo_ta         = request.form.get('mo_ta', '').strip()
        ngay_bat_dau  = request.form.get('ngay_bat_dau', '')
        ngay_ket_thuc = request.form.get('ngay_ket_thuc', '')

        # Kiểm tra đầu vào
        if not ten_du_an:
            flash('Ten du an khong duoc de trong.', 'danger')
            return render_template('project_form.html',
                                   action='add', ten_user=session.get('ten_user'))

        if ngay_bat_dau and ngay_ket_thuc and ngay_bat_dau > ngay_ket_thuc:
            flash('Ngay ket thuc phai sau ngay bat dau.', 'danger')
