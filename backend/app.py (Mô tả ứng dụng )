@app.route('/nhiem-vu/<int:task_id>/trang-thai', methods=['POST'])
@login_required
def task_update_status(task_id):
    """Cập nhật trạng thái nhiệm vụ nhanh (click trực tiếp trên bảng)."""
    trang_thai = request.form.get('trang_thai')
    if trang_thai not in ('chua_lam', 'dang_lam', 'xong'):
        return jsonify({'ok': False, 'msg': 'Trang thai khong hop le'}), 400

    conn = get_db()
    conn.execute("UPDATE tasks SET trang_thai=? WHERE id=?", (trang_thai, task_id))
    conn.commit()
    conn.close()
    return jsonify({'ok': True, 'trang_thai': trang_thai})


