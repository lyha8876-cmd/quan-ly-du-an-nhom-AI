#  3.2 CHI TIẾT DỰ ÁN 
@app.route('/du-an/<int:project_id>')
@login_required
def project_detail(project_id):
    """Chi tiết dự án + danh sách nhiệm vụ bên trong."""
    p = get_project_or_404(project_id)
    if not p:
        flash('Khong tim thay du an.', 'danger')
        return redirect(url_for('projects_list'))

    conn = get_db()
    tasks = conn.execute("""
        SELECT t.*, u.ten AS ten_phu_trach
        FROM tasks t
        LEFT JOIN users u ON t.phu_trach = u.id
        WHERE t.du_an_id = ?
        ORDER BY CASE t.trang_thai
            WHEN 'dang_lam' THEN 1
            WHEN 'chua_lam' THEN 2
            ELSE 3 END,
            t.deadline ASC
    """, (project_id,)).fetchall()

    nguoi_tao = conn.execute(
        "SELECT ten FROM users WHERE id = ?", (p['nguoi_tao'],)
    ).fetchone()

    tong   = len(tasks)
    xong   = sum(1 for t in tasks if t['trang_thai'] == 'xong')
    dang   = sum(1 for t in tasks if t['trang_thai'] == 'dang_lam')
    chua   = sum(1 for t in tasks if t['trang_thai'] == 'chua_lam')
    pct    = int(xong / tong * 100) if tong else 0

    users = get_all_users()
    conn.close()

    return render_template('project_detail.html',
                           project=p, tasks=tasks, users=users,
                           ten_nguoi_tao=nguoi_tao['ten'] if nguoi_tao else '?',
                           tong=tong, xong=xong, dang=dang, chua=chua, pct=pct,
                           today=date.today().isoformat(),
                           ten_user=session.get('ten_user'))


