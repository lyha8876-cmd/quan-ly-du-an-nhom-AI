# PHẦN 2: TRANG CHỦ DASHBOARD

@app.route('/')
@login_required
def index():
    conn = get_db()

    projects = conn.execute("""
        SELECT p.*, u.ten AS ten_nguoi_tao,
               COUNT(t.id)  AS tong_nhiem_vu,
               SUM(CASE WHEN t.trang_thai = 'xong' THEN 1 ELSE 0 END) AS da_xong
        FROM projects p
        JOIN users u ON p.nguoi_tao = u.id
        LEFT JOIN tasks t ON t.du_an_id = p.id
        GROUP BY p.id
        ORDER BY p.ngay_tao DESC
        LIMIT 6
    """).fetchall()

    my_tasks = conn.execute("""
        SELECT t.*, p.ten_du_an
        FROM tasks t
        JOIN projects p ON t.du_an_id = p.id
        WHERE t.phu_trach = ?
        ORDER BY CASE t.trang_thai
            WHEN 'dang_lam' THEN 1
            WHEN 'chua_lam' THEN 2
            ELSE 3 END,
            t.deadline ASC
        LIMIT 8
    """, (session['user_id'],)).fetchall()

    tong_du_an    = conn.execute("SELECT COUNT(*) FROM projects").fetchone()[0]
    tong_nhiem_vu = conn.execute("SELECT COUNT(*) FROM tasks WHERE phu_trach = ?",
                                 (session['user_id'],)).fetchone()[0]
    nhiem_vu_xong = conn.execute(
        "SELECT COUNT(*) FROM tasks WHERE phu_trach = ? AND trang_thai = 'xong'",
        (session['user_id'],)).fetchone()[0]
    nhiem_vu_dang = conn.execute(
        "SELECT COUNT(*) FROM tasks WHERE phu_trach = ? AND trang_thai = 'dang_lam'",
        (session['user_id'],)).fetchone()[0]

    conn.close()
    return render_template('index.html',
                           projects=projects, my_tasks=my_tasks,
                           tong_du_an=tong_du_an,
                           tong_nhiem_vu=tong_nhiem_vu,
                           nhiem_vu_xong=nhiem_vu_xong,
                           nhiem_vu_dang=nhiem_vu_dang,
                           ten_user=session.get('ten_user'))


