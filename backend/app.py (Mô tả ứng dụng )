@app.route('/dang-ky', methods=['GET', 'POST'])
def register():
    if 'user_id' in session:
        return redirect(url_for('index'))

    if request.method == 'POST':
        ten      = request.form.get('ten', '').strip()
        email    = request.form.get('email', '').strip().lower()
        mat_khau = request.form.get('mat_khau', '')
        xac_nhan = request.form.get('xac_nhan_mat_khau', '')

        loi = []
        if not ten or len(ten) < 2:
            loi.append('Ho ten phai co it nhat 2 ky tu.')
        if not email or '@' not in email:
            loi.append('Email khong hop le.')
        if not mat_khau or len(mat_khau) < 6:
            loi.append('Mat khau phai co it nhat 6 ky tu.')
        if mat_khau != xac_nhan:
            loi.append('Mat khau xac nhan khong khop.')

        if loi:
            for l in loi:
                flash(l, 'danger')
            return render_template('register.html', ten=ten, email=email)

        try:
            conn = get_db()
            conn.execute(
                "INSERT INTO users (ten, email, mat_khau) VALUES (?, ?, ?)",
                (ten, email, generate_password_hash(mat_khau))
            )
            conn.commit()
            conn.close()
            flash('Dang ky thanh cong! Hay dang nhap.', 'success')
            return redirect(url_for('login'))
        except sqlite3.IntegrityError:
            flash('Email nay da duoc su dung.', 'danger')
            return render_template('register.html', ten=ten, email=email)

    return render_template('register.html')


@app.route('/dang-nhap', methods=['GET', 'POST'])
def login():
    if 'user_id' in session:
        return redirect(url_for('index'))

    if request.method == 'POST':
        email    = request.form.get('email', '').strip().lower()
        mat_khau = request.form.get('mat_khau', '')

        if not email or not mat_khau:
            flash('Vui long nhap day du email va mat khau.', 'danger')
            return render_template('login.html', email=email)

        conn = get_db()
        user = conn.execute("SELECT * FROM users WHERE email = ?", (email,)).fetchone()
        conn.close()

        if user is None or not check_password_hash(user['mat_khau'], mat_khau):
            flash('Email hoac mat khau khong dung.', 'danger')
            return render_template('login.html', email=email)

        session.clear()
        session['user_id']  = user['id']
        session['ten_user'] = user['ten']
        session['email']    = user['email']

        flash(f'Chao mung tro lai, {user["ten"]}!', 'success')
        return redirect(url_for('index'))

    return render_template('login.html')


