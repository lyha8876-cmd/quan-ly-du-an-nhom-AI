import sqlite3

def khoi_tao_database():
    # Kết nối tạo file database (tên file là taskflow.db)
    conn = sqlite3.connect('taskflow.db')
    cursor = conn.cursor()
    
    # BẮT BUỘC: Bật tính năng kiểm tra ràng buộc khóa ngoại (Foreign Keys)
    cursor.execute("PRAGMA foreign_keys = ON;")
    
    # 1. Tạo bảng Users (Thành viên)
    cursor.execute('''
        CREATE TABLE IF NOT EXISTS users (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            ten VARCHAR(100) NOT NULL,
            email VARCHAR(100) UNIQUE NOT NULL,
            mat_khau VARCHAR(50) NOT NULL
        )
    ''')
    
    # 2. Tạo bảng projects (Dự án nhóm)
    cursor.execute('''
        CREATE TABLE IF NOT EXISTS projects (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            ten_du_an VARCHAR(255) NOT NULL,
            mo_ta TEXT,
            nguoi_tao INTEGER,
            ngay_bat_dau DATE,
            ngay_ket_thuc DATE,
            FOREIGN KEY (nguoi_tao) REFERENCES users(id) ON DELETE SET NULL
        )
    ''')
    
    # 3. Tạo bảng tasks (Nhiệm vụ công việc)
    cursor.execute('''
        CREATE TABLE IF NOT EXISTS tasks (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            ten_nhiem_vu VARCHAR(255) NOT NULL,
            mo_ta VARCHAR(500),
            du_an_id INTEGER,
            phu_trach INTEGER,
            deadline DATE,
            trang_thai VARCHAR(255) DEFAULT 'Chưa làm',
            FOREIGN KEY (du_an_id) REFERENCES projects(id) ON DELETE CASCADE,
            FOREIGN KEY (phu_trach) REFERENCES users(id) ON DELETE SET NULL
        )
    ''')
    
    conn.commit()
    conn.close()
    print("Chúc mừng! Cơ sở dữ liệu SQLite đã được tạo thành công với cấu trúc mới.")

if __name__ == '__main__':
    khoi_tao_database()
