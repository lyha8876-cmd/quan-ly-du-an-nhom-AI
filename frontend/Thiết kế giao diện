
   FILE: static/css/style.css
   MÔ TẢ: Thiết kế giao diện – Hệ thống Quản lý Dự án Nhóm
  
/* GOOGLE FONTS */
@import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap');

/* ── DESIGN TOKENS (Biến màu sắc & khoảng cách) */
:root {
  /* Màu chủ đạo */
  --primary:        #6c63ff;
  --primary-dark:   #574fd6;
  --primary-light:  #a5a0ff;
  --secondary:      #ff6584;
  --accent:         #43e97b;
  --warning:        #ffd166;
  --danger:         #ef476f;
  --info:           #38bdf8;

  /* Nền & glassmorphism */
  --bg-dark:        #0f0e17;
  --bg-card:        rgba(255,255,255,0.06);
  --bg-card-hover:  rgba(255,255,255,0.10);
  --glass-border:   rgba(255,255,255,0.12);
  --glass-blur:     blur(16px);

  /* Chữ */
  --text-white:     #fffffe;
  --text-muted:     rgba(255,255,255,0.55);
  --text-sub:       rgba(255,255,255,0.35);

  /* Bóng */
  --shadow-card:    0 8px 32px rgba(0,0,0,0.4);
  --shadow-glow:    0 0 24px rgba(108,99,255,0.3);

  /* Bo góc & spacing */
  --radius-sm:      8px;
  --radius-md:      14px;
  --radius-lg:      20px;
  --radius-xl:      28px;
  --nav-width:      240px;
}

/*  RESET & BASE */
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

html { scroll-behavior: smooth; }

body {
  font-family: 'Inter', system-ui, sans-serif;
  background: var(--bg-dark);
  color: var(--text-white);
  min-height: 100vh;
  line-height: 1.6;
  overflow-x: hidden;
}

/* Nền gradient động */
body::before {
  content: '';
  position: fixed;
  inset: 0;
  background:
    radial-gradient(ellipse 80% 60% at 20% -10%, rgba(108,99,255,0.25) 0%, transparent 60%),
    radial-gradient(ellipse 60% 50% at 80% 110%, rgba(67,233,123,0.12) 0%, transparent 55%),
    radial-gradient(ellipse 50% 40% at 90% 10%,  rgba(255,101,132,0.10) 0%, transparent 50%);
  pointer-events: none;
  z-index: 0;
}

/* ── SCROLLBAR TÙY CHỈNH  */
::-webkit-scrollbar { width: 6px; }
::-webkit-scrollbar-track { background: transparent; }
::-webkit-scrollbar-thumb { background: var(--primary); border-radius: 99px; }

/* SIDEBAR / NAVBAR  */
.sidebar {
  position: fixed;
  left: 0; top: 0; bottom: 0;
  width: var(--nav-width);
  background: rgba(15,14,23,0.85);
  backdrop-filter: var(--glass-blur);
  border-right: 1px solid var(--glass-border);
  display: flex;
  flex-direction: column;
  padding: 28px 16px;
  z-index: 100;
  transition: transform .3s ease;
}

.sidebar-logo {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 0 8px 28px;
  border-bottom: 1px solid var(--glass-border);
  margin-bottom: 24px;
  text-decoration: none;
}
.sidebar-logo .logo-icon {
  width: 40px; height: 40px;
  background: linear-gradient(135deg, var(--primary), var(--secondary));
  border-radius: var(--radius-sm);
  display: grid; place-items: center;
  font-size: 20px;
  flex-shrink: 0;
}
.sidebar-logo span {
  font-size: 15px; font-weight: 700;
  color: var(--text-white);
  line-height: 1.2;
}
.sidebar-logo small {
  display: block;
  font-size: 10px; font-weight: 400;
  color: var(--text-muted);
  letter-spacing: 1px;
  text-transform: uppercase;
}

.nav-section-title {
  font-size: 10px; font-weight: 600;
  color: var(--text-sub);
  letter-spacing: 2px;
  text-transform: uppercase;
  padding: 0 8px;
  margin: 16px 0 8px;
}

.nav-link {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 10px 12px;
  border-radius: var(--radius-sm);
  text-decoration: none;
  color: var(--text-muted);
  font-size: 14px; font-weight: 500;
  transition: all .2s ease;
  position: relative;
}
.nav-link .nav-icon { font-size: 18px; width: 22px; text-align: center; flex-shrink: 0; }
.nav-link:hover {
  background: var(--bg-card-hover);
  color: var(--text-white);
}
.nav-link.active {
  background: linear-gradient(135deg, rgba(108,99,255,.25), rgba(108,99,255,.10));
  color: var(--primary-light);
  border: 1px solid rgba(108,99,255,.3);
}
.nav-link.active::before {
  content: '';
  position: absolute;
  left: 0; top: 20%; bottom: 20%;
  width: 3px;
  background: var(--primary);
  border-radius: 0 4px 4px 0;
}

.sidebar-footer {
  margin-top: auto;
  border-top: 1px solid var(--glass-border);
  padding-top: 16px;
}
.user-chip {
  display: flex; align-items: center; gap: 10px;
  padding: 10px 12px;
  border-radius: var(--radius-sm);
  background: var(--bg-card);
  border: 1px solid var(--glass-border);
}
.user-avatar {
  width: 34px; height: 34px;
  background: linear-gradient(135deg, var(--primary), var(--secondary));
  border-radius: 50%;
  display: grid; place-items: center;
  font-size: 14px; font-weight: 700;
  flex-shrink: 0;
}
.user-chip-info { flex: 1; min-width: 0; }
.user-chip-name { font-size: 13px; font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.user-chip-role { font-size: 10px; color: var(--text-muted); }

/*  NỘI DUNG CHÍNH  */
.main-content {
  margin-left: var(--nav-width);
  padding: 32px;
  position: relative;
  z-index: 1;
  min-height: 100vh;
}

/* TOPBAR */
.topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 32px;
}
.page-title { font-size: 26px; font-weight: 800; letter-spacing: -0.5px; }
.page-title span { color: var(--primary-light); }
.page-subtitle { font-size: 14px; color: var(--text-muted); margin-top: 2px; }

/*  STAT CARDS  */
.stats-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
  gap: 16px;
  margin-bottom: 28px;
}
.stat-card {
  background: var(--bg-card);
  border: 1px solid var(--glass-border);
  backdrop-filter: var(--glass-blur);
  border-radius: var(--radius-md);
  padding: 20px;
  transition: transform .25s ease, border-color .25s ease;
  position: relative;
  overflow: hidden;
}
.stat-card::after {
  content: '';
  position: absolute;
  inset: 0;
  background: linear-gradient(135deg, var(--color-a, #6c63ff) 0%, transparent 60%);
  opacity: .08;
  pointer-events: none;
}
.stat-card:hover { transform: translateY(-3px); border-color: rgba(255,255,255,.22); }
.stat-icon {
  font-size: 24px;
  width: 46px; height: 46px;
  border-radius: var(--radius-sm);
  display: grid; place-items: center;
  margin-bottom: 12px;
}
.stat-value { font-size: 32px; font-weight: 800; line-height: 1; }
.stat-label { font-size: 12px; color: var(--text-muted); margin-top: 4px; font-weight: 500; }

/* Màu icon stat */
.stat-card.purple .stat-icon { background: rgba(108,99,255,.2); }
.stat-card.green  .stat-icon { background: rgba(67,233,123,.2); }
.stat-card.pink   .stat-icon { background: rgba(255,101,132,.2); }
.stat-card.blue   .stat-icon { background: rgba(56,189,248,.2); }
.stat-card.purple { --color-a: #6c63ff; }
.stat-card.green  { --color-a: #43e97b; }
.stat-card.pink   { --color-a: #ff6584; }
.stat-card.blue   { --color-a: #38bdf8; }

/* CARD CHUNG  */
.card {
  background: var(--bg-card);
  border: 1px solid var(--glass-border);
  backdrop-filter: var(--glass-blur);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-card);
  overflow: hidden;
}
.card-header {
  padding: 18px 22px;
  border-bottom: 1px solid var(--glass-border);
  display: flex; align-items: center; justify-content: space-between;
}
.card-title { font-size: 15px; font-weight: 700; }
.card-body { padding: 20px 22px; }

/* GRID 2 CỘT */
.two-col { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }

/* BẢNG DỰ ÁN  */
.project-list { list-style: none; display: flex; flex-direction: column; gap: 10px; }
.project-item {
  display: flex; align-items: center; gap: 14px;
  padding: 14px 16px;
  border-radius: var(--radius-sm);
  background: rgba(255,255,255,.04);
  border: 1px solid var(--glass-border);
  transition: background .2s ease;
  cursor: pointer;
  text-decoration: none;
  color: inherit;
}
.project-item:hover { background: var(--bg-card-hover); }
.project-color {
  width: 10px; height: 10px;
  border-radius: 50%;
  flex-shrink: 0;
}
.project-info { flex: 1; min-width: 0; }
.project-name { font-size: 14px; font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.project-meta { font-size: 11px; color: var(--text-muted); margin-top: 2px; }

/* Progress bar */
.progress-wrap { margin-top: 6px; }
.progress-bar-bg {
  height: 4px; border-radius: 99px;
  background: rgba(255,255,255,.1);
  overflow: hidden;
}
.progress-bar-fill {
  height: 100%; border-radius: 99px;
  background: linear-gradient(90deg, var(--primary), var(--accent));
  transition: width .5s ease;
}

/*  DANH SÁCH NHIỆM VỤ  */
.task-list { display: flex; flex-direction: column; gap: 8px; }
.task-item {
  display: flex; align-items: center; gap: 12px;
  padding: 12px 14px;
  border-radius: var(--radius-sm);
  background: rgba(255,255,255,.04);
  border: 1px solid var(--glass-border);
  transition: background .2s;
}
.task-item:hover { background: var(--bg-card-hover); }
.task-check {
  width: 20px; height: 20px;
  border-radius: 50%;
  border: 2px solid;
  display: grid; place-items: center;
  flex-shrink: 0;
  font-size: 10px;
}
.task-check.chua_lam  { border-color: var(--text-sub); }
.task-check.dang_lam  { border-color: var(--warning); background: rgba(255,209,102,.1); }
.task-check.xong      { border-color: var(--accent); background: rgba(67,233,123,.15); color: var(--accent); }
.task-info { flex: 1; min-width: 0; }
.task-name { font-size: 13px; font-weight: 500; }
.task-name.xong { text-decoration: line-through; color: var(--text-muted); }
.task-project { font-size: 11px; color: var(--text-muted); }
.task-deadline {
  font-size: 11px; font-weight: 600;
  padding: 2px 8px;
  border-radius: 99px;
  background: rgba(255,255,255,.08);
  white-space: nowrap;
}
.task-deadline.overdue { background: rgba(239,71,111,.2); color: var(--danger); }

/*  BADGES / TAGS  */
.badge {
  display: inline-flex; align-items: center; gap: 4px;
  padding: 3px 10px;
  border-radius: 99px;
  font-size: 11px; font-weight: 600;
  letter-spacing: .3px;
}
.badge-chua_lam { background: rgba(255,255,255,.1); color: var(--text-muted); }
.badge-dang_lam { background: rgba(255,209,102,.15); color: var(--warning); }
.badge-xong     { background: rgba(67,233,123,.15); color: var(--accent); }

/*  BUTTON  */
.btn {
  display: inline-flex; align-items: center; gap: 8px;
  padding: 10px 20px;
  border-radius: var(--radius-sm);
  font-size: 14px; font-weight: 600;
  border: none; cursor: pointer;
  text-decoration: none;
  transition: all .2s ease;
  font-family: inherit;
  white-space: nowrap;
}
.btn-primary {
  background: linear-gradient(135deg, var(--primary), var(--primary-dark));
  color: #fff;
  box-shadow: 0 4px 16px rgba(108,99,255,.35);
}
.btn-primary:hover {
  transform: translateY(-1px);
  box-shadow: 0 6px 24px rgba(108,99,255,.5);
}
.btn-outline {
  background: transparent;
  color: var(--text-muted);
  border: 1px solid var(--glass-border);
}
.btn-outline:hover { background: var(--bg-card-hover); color: var(--text-white); }
.btn-danger { background: rgba(239,71,111,.2); color: var(--danger); border: 1px solid rgba(239,71,111,.3); }
.btn-sm { padding: 6px 14px; font-size: 12px; }

/*  FORM CONTROLS  */
.form-group { margin-bottom: 18px; }
.form-label {
  display: block; font-size: 13px; font-weight: 600;
  color: var(--text-muted); margin-bottom: 6px;
}
.form-control {
  width: 100%;
  padding: 11px 14px;
  background: rgba(255,255,255,.06);
  border: 1px solid var(--glass-border);
  border-radius: var(--radius-sm);
  color: var(--text-white);
  font-size: 14px;
  font-family: inherit;
  transition: border-color .2s, background .2s;
  outline: none;
}
.form-control::placeholder { color: var(--text-sub); }
.form-control:focus {
  border-color: var(--primary);
  background: rgba(108,99,255,.08);
  box-shadow: 0 0 0 3px rgba(108,99,255,.15);
}
.form-control.is-invalid { border-color: var(--danger); }
select.form-control option { background: #1a1a2e; }

/*  FLASH MESSAGES  */
.flash-container {
  position: fixed;
  top: 20px; right: 20px;
  z-index: 9999;
  display: flex; flex-direction: column; gap: 8px;
  max-width: 360px;
}
.flash-msg {
  display: flex; align-items: flex-start; gap: 10px;
  padding: 14px 16px;
  border-radius: var(--radius-sm);
  font-size: 13px; font-weight: 500;
  backdrop-filter: var(--glass-blur);
  border: 1px solid;
  animation: slideInRight .3s ease;
  cursor: pointer;
  position: relative;
}
@keyframes slideInRight {
  from { transform: translateX(110%); opacity: 0; }
  to   { transform: translateX(0);    opacity: 1; }
}
.flash-msg.success { background: rgba(67,233,123,.15); border-color: rgba(67,233,123,.3); color: #6effa1; }
.flash-msg.danger  { background: rgba(239,71,111,.15); border-color: rgba(239,71,111,.3); color: #ff8aaa; }
.flash-msg.warning { background: rgba(255,209,102,.15); border-color: rgba(255,209,102,.3); color: #ffe066; }
.flash-msg.info    { background: rgba(56,189,248,.15);  border-color: rgba(56,189,248,.3);  color: #7dd3fc; }
.flash-icon { font-size: 16px; flex-shrink: 0; }
.flash-close {
  position: absolute; right: 10px; top: 50%;
  transform: translateY(-50%);
  opacity: .5; cursor: pointer; font-size: 16px; font-weight: 700;
  background: none; border: none; color: inherit; padding: 0 4px;
}
.flash-close:hover { opacity: 1; }

/*  BẢNG TABLE  */
.table-wrapper { overflow-x: auto; }
table { width: 100%; border-collapse: collapse; font-size: 13px; }
thead th {
  text-align: left;
  padding: 10px 14px;
  color: var(--text-muted);
  font-size: 11px; font-weight: 600;
  letter-spacing: 1px; text-transform: uppercase;
  border-bottom: 1px solid var(--glass-border);
}
tbody tr {
  border-bottom: 1px solid rgba(255,255,255,.05);
  transition: background .15s;
}
tbody tr:hover { background: rgba(255,255,255,.04); }
tbody td { padding: 12px 14px; vertical-align: middle; }

/*  TRANG AUTH (Đăng ký / Đăng nhập)  */
.auth-page {
  min-height: 100vh;
  display: grid;
  grid-template-columns: 1fr 1fr;
  position: relative; z-index: 1;
}

.auth-left {
  display: flex; flex-direction: column;
  justify-content: center; align-items: center;
  padding: 60px;
  background: rgba(0,0,0,.15);
  border-right: 1px solid var(--glass-border);
  position: relative;
  overflow: hidden;
}
.auth-left-content { max-width: 400px; text-align: center; }
.auth-brand {
  display: inline-flex; align-items: center; gap: 10px;
  margin-bottom: 48px;
  text-decoration: none;
}
.auth-brand-icon {
  width: 48px; height: 48px;
  background: linear-gradient(135deg, var(--primary), var(--secondary));
  border-radius: var(--radius-sm);
  display: grid; place-items: center;
  font-size: 24px;
}
.auth-brand-name { font-size: 18px; font-weight: 800; color: var(--text-white); }

.auth-illustration {
  font-size: 100px; margin-bottom: 28px;
  animation: float 4s ease-in-out infinite;
}
@keyframes float {
  0%,100% { transform: translateY(0); }
  50%      { transform: translateY(-12px); }
}
.auth-tagline { font-size: 26px; font-weight: 800; line-height: 1.3; margin-bottom: 12px; }
.auth-tagline span { color: var(--primary-light); }
.auth-description { font-size: 14px; color: var(--text-muted); line-height: 1.7; }

.feature-chips { display: flex; flex-wrap: wrap; gap: 8px; justify-content: center; margin-top: 28px; }
.feature-chip {
  display: flex; align-items: center; gap: 6px;
  padding: 6px 14px;
  background: var(--bg-card);
  border: 1px solid var(--glass-border);
  border-radius: 99px;
  font-size: 12px; color: var(--text-muted);
}

.auth-right {
  display: flex; flex-direction: column;
  justify-content: center; align-items: center;
  padding: 60px;
}
.auth-form-wrap { width: 100%; max-width: 400px; }
.auth-form-title { font-size: 28px; font-weight: 800; margin-bottom: 6px; }
.auth-form-sub { font-size: 14px; color: var(--text-muted); margin-bottom: 32px; }

.auth-divider {
  display: flex; align-items: center; gap: 12px;
  margin: 20px 0; color: var(--text-sub); font-size: 12px;
}
.auth-divider::before, .auth-divider::after {
  content: ''; flex: 1; height: 1px; background: var(--glass-border);
}

.auth-footer-link { font-size: 13px; color: var(--text-muted); text-align: center; margin-top: 20px; }
.auth-footer-link a { color: var(--primary-light); font-weight: 600; text-decoration: none; }
.auth-footer-link a:hover { text-decoration: underline; }

/* Hiệu ứng nền trái */
.auth-left::before {
  content: '';
  position: absolute;
  width: 300px; height: 300px;
  background: radial-gradient(circle, rgba(108,99,255,.3) 0%, transparent 70%);
  bottom: -100px; left: -100px;
  border-radius: 50%;
}
.auth-left::after {
  content: '';
  position: absolute;
  width: 200px; height: 200px;
  background: radial-gradient(circle, rgba(67,233,123,.2) 0%, transparent 70%);
  top: -60px; right: -60px;
  border-radius: 50%;
}

/*  PASSWORD STRENGTH  */
.password-strength { margin-top: 6px; }
.strength-bar { display: flex; gap: 4px; margin-bottom: 4px; }
.strength-seg {
  flex: 1; height: 3px; border-radius: 99px;
  background: rgba(255,255,255,.1);
  transition: background .3s;
}
.strength-seg.active.weak   { background: var(--danger); }
.strength-seg.active.medium { background: var(--warning); }
.strength-seg.active.strong { background: var(--accent); }
.strength-text { font-size: 11px; color: var(--text-muted); }

/*  TOGGLE PASSWORD  */
.input-group { position: relative; }
.input-group .form-control { padding-right: 42px; }
.input-toggle {
  position: absolute; right: 12px; top: 50%;
  transform: translateY(-50%);
  background: none; border: none; color: var(--text-muted);
  cursor: pointer; font-size: 16px; padding: 2px;
  transition: color .2s;
}
.input-toggle:hover { color: var(--text-white); }

/*  EMPTY STATE  */
.empty-state {
  display: flex; flex-direction: column;
  align-items: center; justify-content: center;
  padding: 48px 24px; text-align: center;
  color: var(--text-muted);
}
.empty-state-icon { font-size: 56px; margin-bottom: 16px; opacity: .5; }
.empty-state-title { font-size: 16px; font-weight: 600; margin-bottom: 6px; color: var(--text-white); }
.empty-state-desc { font-size: 13px; }

/*  MODAL  */
.modal-overlay {
  position: fixed; inset: 0;
  background: rgba(0,0,0,.7);
  backdrop-filter: blur(4px);
  z-index: 1000;
  display: grid; place-items: center;
  opacity: 0; visibility: hidden;
  transition: all .2s ease;
}
.modal-overlay.open { opacity: 1; visibility: visible; }
.modal {
  background: #1a1927;
  border: 1px solid var(--glass-border);
  border-radius: var(--radius-lg);
  width: 90%; max-width: 480px;
  transform: scale(.95);
  transition: transform .2s ease;
  overflow: hidden;
}
.modal-overlay.open .modal { transform: scale(1); }
.modal-header {
  display: flex; align-items: center; justify-content: space-between;
  padding: 18px 22px;
  border-bottom: 1px solid var(--glass-border);
}
.modal-title { font-size: 16px; font-weight: 700; }
.modal-close {
  background: none; border: none; color: var(--text-muted);
  font-size: 22px; cursor: pointer; padding: 0 4px;
  line-height: 1;
}
.modal-close:hover { color: var(--text-white); }
.modal-body { padding: 22px; }
.modal-footer {
  padding: 16px 22px;
  border-top: 1px solid var(--glass-border);
  display: flex; justify-content: flex-end; gap: 10px;
}

/*  RESPONSIVE  */
@media (max-width: 900px) {
  .auth-page { grid-template-columns: 1fr; }
  .auth-left { display: none; }
  .auth-right { padding: 40px 24px; }
  .two-col { grid-template-columns: 1fr; }
}
@media (max-width: 768px) {
  .sidebar { transform: translateX(-100%); }
  .sidebar.open { transform: translateX(0); }
  .main-content { margin-left: 0; padding: 20px 16px; }
  .stats-grid { grid-template-columns: repeat(2, 1fr); }
}
@media (max-width: 480px) {
  .stats-grid { grid-template-columns: 1fr; }
}
