      <span class="nav-icon">📁</span> Dự án
    </a>
    <a href="#" class="nav-link" style="opacity:.4;pointer-events:none">
      <span class="nav-icon">📊</span> Biểu đồ tiến độ
    </a>
    <a href="#" class="nav-link" style="opacity:.4;pointer-events:none">
      <span class="nav-icon">🤖</span> AI gợi ý
    </a>

    <div class="sidebar-footer">
      <div class="user-chip">
