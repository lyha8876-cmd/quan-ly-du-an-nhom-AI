{% extends "base.html" %}
{% block title %}Đăng ký tài khoản{% endblock %}

{% block body %}
<div class="auth-page">

  <!--  CỘT TRÁI – MINH HOẠ  -->
  <div class="auth-left">
    <div class="auth-left-content">
      <a href="#" class="auth-brand">
        <div class="auth-brand-icon">📋</div>
        <span class="auth-brand-name">TaskFlow</span>
      </a>

      <div class="auth-illustration">🎯</div>

      <h1 class="auth-tagline">
        Bắt đầu hành trình<br/>
        <span>cùng nhóm bạn</span>
      </h1>
      <p class="auth-description">
        Tạo tài khoản miễn phí trong vài giây.<br/>
        Không cần thẻ tín dụng – không giới hạn dự án.<br/>
        Bắt đầu ngay hôm nay!
      </p>

      <div class="feature-chips">
        <span class="feature-chip">🆓 Hoàn toàn miễn phí</span>
        <span class="feature-chip">🔐 Bảo mật an toàn</span>
        <span class="feature-chip">⚡ Thiết lập nhanh</span>
        <span class="feature-chip">👥 Làm việc nhóm</span>
      </div>
    </div>
  </div>

  <!--  CỘT PHẢI – FORM ĐĂNG KÝ  -->
  <div class="auth-right">
    <div class="auth-form-wrap">
      <h2 class="auth-form-title">Tạo tài khoản mới ✨</h2>
      <p class="auth-form-sub">Điền thông tin bên dưới để bắt đầu</p>

      <form method="POST" action="{{ url_for('register') }}" id="register-form" novalidate>

        <!-- Họ tên -->
        <div class="form-group">
          <label class="form-label" for="ten">👤 Họ và tên</label>
          <input
            type="text"
            id="ten"
            name="ten"
            class="form-control"
            placeholder="Ví dụ: Nguyễn Văn A"
            value="{{ ten or '' }}"
            required
            autocomplete="name"
            minlength="2"
          />
        </div>

        <!-- Email -->
        <div class="form-group">
          <label class="form-label" for="email">📧 Địa chỉ Email</label>
          <input
            type="email"
            id="email"
            name="email"
            class="form-control"
            placeholder="example@email.com"
            value="{{ email or '' }}"
            required
            autocomplete="email"
          />
        </div>

        <!-- Mật khẩu -->
        <div class="form-group">
          <label class="form-label" for="mat_khau">🔒 Mật khẩu</label>
          <div class="input-group">
            <input
              type="password"
              id="mat_khau"
              name="mat_khau"
              class="form-control"
              placeholder="Tối thiểu 6 ký tự"
              required
              minlength="6"
              autocomplete="new-password"
              oninput="checkStrength(this.value)"
            />
            <button type="button" class="input-toggle"
                    onclick="togglePassword('mat_khau','toggle-pw1')"
                    id="toggle-pw1" aria-label="Hiện/ẩn mật khẩu">👁️</button>
          </div>
          <!-- Thanh độ mạnh mật khẩu -->
          <div class="password-strength" id="strength-wrap" style="display:none">
            <div class="strength-bar">
              <div class="strength-seg" id="seg1"></div>
              <div class="strength-seg" id="seg2"></div>
              <div class="strength-seg" id="seg3"></div>
            </div>
            <span class="strength-text" id="strength-text">--</span>
          </div>
        </div>

        <!-- Xác nhận mật khẩu -->
        <div class="form-group">
          <label class="form-label" for="xac_nhan_mat_khau">🔒 Xác nhận mật khẩu</label>
          <div class="input-group">
            <input
              type="password"
              id="xac_nhan_mat_khau"
              name="xac_nhan_mat_khau"
              class="form-control"
              placeholder="Nhập lại mật khẩu"
              required
              autocomplete="new-password"
              oninput="checkConfirm()"
            />
            <button type="button" class="input-toggle"
                    onclick="togglePassword('xac_nhan_mat_khau','toggle-pw2')"
                    id="toggle-pw2" aria-label="Hiện/ẩn mật khẩu">👁️</button>
          </div>
          <p id="confirm-msg" style="font-size:11px;margin-top:4px;display:none"></p>
        </div>

        <!-- Nút đăng ký -->
        <button type="submit" class="btn btn-primary"
                style="width:100%;justify-content:center;padding:13px;"
                id="btn-register">
          🚀 Tạo tài khoản
        </button>

      </form>

      <div class="auth-divider">đã có tài khoản?</div>

      <p class="auth-footer-link">
        <a href="{{ url_for('login') }}">← Quay lại đăng nhập</a>
      </p>

      <!-- Ghi chú bảo mật -->
      <div style="margin-top:20px;padding:12px;background:rgba(67,233,123,.06);border:1px solid rgba(67,233,123,.15);border-radius:10px;font-size:12px;color:var(--text-muted);">
        🔐 <strong style="color:#6effa1">Bảo mật:</strong>
        Mật khẩu được mã hóa bằng thuật toán <code>PBKDF2-SHA256</code> trước khi lưu vào cơ sở dữ liệu. Chúng tôi không lưu mật khẩu gốc của bạn.
      </div>
    </div>
  </div>

</div>
{% endblock %}

{% block extra_js %}
<script>
// Kiểm tra độ mạnh mật khẩu
function checkStrength(val) {
  const wrap = document.getElementById('strength-wrap');
  const text = document.getElementById('strength-text');
  const segs = [document.getElementById('seg1'),
                document.getElementById('seg2'),
                document.getElementById('seg3')];

  if (!val) { wrap.style.display = 'none'; return; }
  wrap.style.display = 'block';

  let score = 0;
  if (val.length >= 6)  score++;
  if (val.length >= 10) score++;
  if (/[A-Z]/.test(val) || /[0-9]/.test(val) || /[^a-zA-Z0-9]/.test(val)) score++;

  const levels = ['', 'weak', 'medium', 'strong'];
  const labels = ['', '⚠️ Yếu', '🟡 Trung bình', '✅ Mạnh'];

  segs.forEach((s, i) => {
    s.className = 'strength-seg';
    if (i < score) s.classList.add('active', levels[score]);
  });
  text.textContent = labels[score] || '';
}

// Kiểm tra khớp mật khẩu
function checkConfirm() {
  const pw  = document.getElementById('mat_khau').value;
  const cf  = document.getElementById('xac_nhan_mat_khau').value;
  const msg = document.getElementById('confirm-msg');
  if (!cf) { msg.style.display = 'none'; return; }
  msg.style.display = 'block';
  if (pw === cf) {
    msg.textContent = '✅ Mật khẩu khớp';
    msg.style.color = 'var(--accent)';
  } else {
    msg.textContent = '❌ Mật khẩu không khớp';
    msg.style.color = 'var(--danger)';
  }
}
</script>
{% endblock %}






