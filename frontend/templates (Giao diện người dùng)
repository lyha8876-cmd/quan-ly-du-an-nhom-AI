{% extends "layout.html" %}
{% block title %}{% if action == 'add' %}Tạo dự án mới{% else %}Sửa dự án{% endif %}{% endblock %}

{% block content %}

<!--  TOPBAR  -->
<div class="topbar">
  <div>
    <h1 class="page-title">
      {% if action == 'add' %}➕ Tạo <span>dự án mới</span>
      {% else %}✏️ Sửa <span>dự án</span>{% endif %}
    </h1>
    <p class="page-subtitle">
      {% if action == 'add' %}Điền thông tin để bắt đầu dự án nhóm
      {% else %}Cập nhật thông tin dự án "{{ project.ten_du_an }}"{% endif %}
    </p>
  </div>
  <a href="{{ url_for('projects_list') }}" class="btn btn-outline">← Quay lại</a>
</div>

<!--  FORM  -->
<div style="display:grid;grid-template-columns:1fr 380px;gap:24px;align-items:start">

  <!-- CỘT TRÁI: Form chính -->
  <div class="card">
    <div class="card-header">
      <span class="card-title">
        {% if action == 'add' %}📋 Thông tin dự án mới{% else %}📋 Chỉnh sửa thông tin{% endif %}
      </span>
    </div>
    <div class="card-body">
      <form method="POST"
            action="{% if action == 'add' %}{{ url_for('project_add') }}
                    {% else %}{{ url_for('project_edit', project_id=project.id) }}{% endif %}"
            id="project-form" novalidate>

        <!-- Tên dự án -->
        <div class="form-group">
          <label class="form-label" for="ten_du_an">
            📁 Tên dự án <span style="color:var(--danger)">*</span>
          </label>
          <input type="text" id="ten_du_an" name="ten_du_an"
                 class="form-control"
                 placeholder="VD: Hệ thống quản lý bán hàng..."
                 value="{{ project.ten_du_an if action == 'edit' else (form_data.ten_du_an if form_data else '') }}"
                 required maxlength="200"
                 oninput="updateCounter(this, 200, 'cnt-ten')" />
          <div style="display:flex;justify-content:space-between;margin-top:4px">
            <span style="font-size:11px;color:var(--text-sub)">Bắt buộc</span>
            <span id="cnt-ten" style="font-size:11px;color:var(--text-sub)">0/200</span>
          </div>
        </div>

        <!-- Mô tả -->
        <div class="form-group">
          <label class="form-label" for="mo_ta">📝 Mô tả dự án</label>
          <textarea id="mo_ta" name="mo_ta" class="form-control"
                    rows="4"
                    placeholder="Mô tả mục tiêu, phạm vi, công nghệ sử dụng..."
                    maxlength="1000"
                    oninput="updateCounter(this, 1000, 'cnt-mo-ta')"
                    style="resize:vertical">{{ project.mo_ta if action == 'edit' else (form_data.mo_ta if form_data else '') }}</textarea>
          <div style="display:flex;justify-content:flex-end;margin-top:4px">
            <span id="cnt-mo-ta" style="font-size:11px;color:var(--text-sub)">0/1000</span>
          </div>
        </div>

        <!-- Ngày tháng -->
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:14px">
          <div class="form-group">
            <label class="form-label" for="ngay_bat_dau">🗓 Ngày bắt đầu</label>
            <input type="date" id="ngay_bat_dau" name="ngay_bat_dau"
                   class="form-control"
                   value="{{ project.ngay_bat_dau if action == 'edit' else today }}"
                   onchange="validateDates()" />
          </div>
          <div class="form-group">
            <label class="form-label" for="ngay_ket_thuc">🏁 Ngày kết thúc</label>
            <input type="date" id="ngay_ket_thuc" name="ngay_ket_thuc"
                   class="form-control"
                   value="{{ project.ngay_ket_thuc if action == 'edit' else '' }}"
                   onchange="validateDates()" />
          </div>
        </div>
        <p id="date-error" style="font-size:12px;color:var(--danger);display:none;margin-top:-10px;margin-bottom:12px">
          ❌ Ngày kết thúc phải sau ngày bắt đầu
        </p>

        <!-- Nút submit -->
        <div style="display:flex;gap:10px;margin-top:8px">
          <button type="submit" class="btn btn-primary" id="btn-submit"
                  style="flex:1;justify-content:center;padding:13px">
            {% if action == 'add' %}🚀 Tạo dự án{% else %}💾 Lưu thay đổi{% endif %}
          </button>
          <a href="{{ url_for('projects_list') }}" class="btn btn-outline"
             style="padding:13px 20px">Hủy</a>
        </div>

      </form>
    </div>
  </div>

  <!-- CỘT PHẢI: Hướng dẫn & Preview -->
  <div style="display:flex;flex-direction:column;gap:16px">

    <!-- Tips -->
    <div class="card">
      <div class="card-header">
        <span class="card-title">💡 Gợi ý đặt tên</span>
      </div>
      <div class="card-body" style="padding:16px">
        <div style="display:flex;flex-direction:column;gap:8px;font-size:13px">
          <div style="padding:8px 12px;background:rgba(108,99,255,.1);border-radius:8px;
                      border-left:3px solid var(--primary)">
            📱 Ứng dụng quản lý bán hàng
          </div>
          <div style="padding:8px 12px;background:rgba(67,233,123,.1);border-radius:8px;
                      border-left:3px solid var(--accent)">
            🌐 Website giới thiệu công ty
          </div>
          <div style="padding:8px 12px;background:rgba(255,101,132,.1);border-radius:8px;
                      border-left:3px solid var(--secondary)">
            📊 Hệ thống báo cáo nội bộ
          </div>
          <div style="padding:8px 12px;background:rgba(255,209,102,.1);border-radius:8px;
                      border-left:3px solid var(--warning)">
            🎓 Đồ án tốt nghiệp nhóm
          </div>
        </div>
      </div>
    </div>

    <!-- Preview card -->
    <div class="card">
      <div class="card-header">
        <span class="card-title">👁 Xem trước</span>
      </div>
      <div class="card-body" style="padding:16px">
        <div style="border-radius:10px;overflow:hidden;border:1px solid var(--glass-border)">
          <div id="preview-color" style="height:5px;background:var(--primary)"></div>
          <div style="padding:12px">
            <div id="preview-name"
                 style="font-size:14px;font-weight:700;color:var(--text-white);margin-bottom:6px">
              {{ project.ten_du_an if action == 'edit' else 'Tên dự án...' }}
            </div>
            <div id="preview-desc"
                 style="font-size:12px;color:var(--text-muted);margin-bottom:10px;
                        min-height:20px">
              {{ project.mo_ta if (action == 'edit' and project.mo_ta) else 'Mô tả dự án...' }}
            </div>
            <div style="display:flex;gap:8px">
              <span style="font-size:11px;padding:3px 8px;border-radius:99px;
                           background:rgba(108,99,255,.15);color:var(--primary-light)">
                0 nhiệm vụ
              </span>
              <span style="font-size:11px;padding:3px 8px;border-radius:99px;
                           background:rgba(67,233,123,.15);color:var(--accent)">
                0% xong
              </span>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Lưu ý -->
    <div style="padding:14px;background:rgba(56,189,248,.08);
                border:1px solid rgba(56,189,248,.2);border-radius:12px;
                font-size:12px;color:var(--text-muted)">
      ℹ️ <strong style="color:#7dd3fc">Lưu ý:</strong><br/>
      Sau khi tạo dự án, bạn có thể thêm nhiệm vụ và phân công cho các thành viên trong nhóm.
    </div>

  </div>
</div>

{% endblock %}

{% block extra_js %}
<script>
// Đếm ký tự
function updateCounter(el, max, id) {
  var cnt = document.getElementById(id);
  if (cnt) cnt.textContent = el.value.length + '/' + max;
}

// Preview realtime
var nameEl = document.getElementById('ten_du_an');
var descEl = document.getElementById('mo_ta');
var pName  = document.getElementById('preview-name');
var pDesc  = document.getElementById('preview-desc');

if (nameEl) {
  // Init counters
  updateCounter(nameEl, 200, 'cnt-ten');
  nameEl.addEventListener('input', function() {
    pName.textContent = this.value || 'Tên dự án...';
    updateCounter(this, 200, 'cnt-ten');
  });
}
if (descEl) {
  updateCounter(descEl, 1000, 'cnt-mo-ta');
  descEl.addEventListener('input', function() {
    pDesc.textContent = this.value || 'Mô tả dự án...';
    updateCounter(this, 1000, 'cnt-mo-ta');
  });
}

// Validate ngày
function validateDates() {
  var start = document.getElementById('ngay_bat_dau').value;
  var end   = document.getElementById('ngay_ket_thuc').value;
  var err   = document.getElementById('date-error');
  var btn   = document.getElementById('btn-submit');
  if (start && end && start > end) {
    err.style.display = 'block';
    btn.disabled = true;
    btn.style.opacity = '.5';
  } else {
    err.style.display = 'none';
    btn.disabled = false;
    btn.style.opacity = '';
  }
}
</script>
{% endblock %}








