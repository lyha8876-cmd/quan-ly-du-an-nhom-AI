<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{% block title %}Quản Lý Dự Án Nhóm{% endblock %} | TaskFlow</title>
  <meta name="description" content="Hệ thống quản lý dự án nhóm thông minh tích hợp AI – Nhóm 02" />
  <link rel="stylesheet" href="{{ url_for('static', filename='css/style.css') }}" />
  {% block extra_head %}{% endblock %}
</head>
<body>

  {% with messages = get_flashed_messages(with_categories=true) %}
    {% if messages %}
    <div class="flash-container" id="flash-container">
      {% for category, message in messages %}
      <div class="flash-msg {{ category }}" onclick="this.remove()">
        <span class="flash-icon">
          {% if category == 'success' %}✅
          {% elif category == 'danger' %}❌
          {% elif category == 'warning' %}⚠️
          {% else %}ℹ️{% endif %}
        </span>
        <span>{{ message }}</span>
        <button class="flash-close" onclick="event.stopPropagation();this.parentElement.remove()">×</button>
      </div>
      {% endfor %}
    </div>
    {% endif %}
  {% endwith %}

  {% block body %}{% endblock %}

  <script src="{{ url_for('static', filename='js/main.js') }}"></script>
  {% block extra_js %}{% endblock %}
</body>
</html>





2. index.html
{% extends "layout.html" %}
{% block title %}Trang chủ{% endblock %}

{% block content %}

<div class="topbar">
  <div>
    <h1 class="page-title">Xin chào, <span>{{ ten_user }}!</span> 👋</h1>
    <p class="page-subtitle">Tổng quan hoạt động nhóm hôm nay</p>
  </div>
  <a href="{{ url_for('project_add') }}" class="btn btn-primary">＋ Tạo dự án</a>
</div>

<!--  THỐNG KÊ  -->
<div class="stats-grid">
  <div class="stat-card purple">
    <div class="stat-icon">📁</div>
    <div class="stat-value">{{ tong_du_an }}</div>
    <div class="stat-label">Tổng dự án</div>
  </div>
  <div class="stat-card blue">
    <div class="stat-icon">📋</div>
    <div class="stat-value">{{ tong_nhiem_vu }}</div>
    <div class="stat-label">Nhiệm vụ của tôi</div>
  </div>
  <div class="stat-card green">
    <div class="stat-icon">✅</div>
    <div class="stat-value">{{ nhiem_vu_xong }}</div>
    <div class="stat-label">Đã hoàn thành</div>
  </div>
  <div class="stat-card pink">
    <div class="stat-icon">▶</div>
    <div class="stat-value">{{ nhiem_vu_dang }}</div>
    <div class="stat-label">Đang làm</div>
  </div>
</div>

<!--  NỘI DUNG CHÍNH  -->
<div class="two-col">

  <!-- Dự án gần đây -->
  <div class="card">
    <div class="card-header">
      <span class="card-title">📁 Dự án gần đây</span>
      <a href="{{ url_for('projects_list') }}" class="btn btn-outline btn-sm">Xem tất cả</a>
    </div>
    <div class="card-body">
      {% if projects %}
      <ul class="project-list">
        {% for p in projects %}
        {% set pct = ((p.da_xong or 0) / (p.tong_nhiem_vu or 1) * 100) | int %}
        {% set colors = ['#6c63ff','#43e97b','#ff6584','#38bdf8','#ffd166','#a78bfa'] %}
        <li>
          <a href="{{ url_for('project_detail', project_id=p.id) }}" class="project-item">
            <div class="project-color"
                 style="background:{{ colors[loop.index0 % colors|length] }}"></div>
            <div class="project-info">
              <div class="project-name">{{ p.ten_du_an }}</div>
              <div class="project-meta">
                👤 {{ p.ten_nguoi_tao }} &nbsp;·&nbsp;
                📋 {{ p.tong_nhiem_vu }} nhiệm vụ &nbsp;·&nbsp;
                ✅ {{ p.da_xong or 0 }} xong
              </div>
              <div class="progress-wrap">
                <div class="progress-bar-bg">
                  <div class="progress-bar-fill" style="width:{{ pct }}%"></div>
                </div>
              </div>
            </div>
            <span style="font-size:12px;color:var(--text-muted);font-weight:700">{{ pct }}%</span>
          </a>
        </li>
        {% endfor %}
      </ul>
      {% else %}
      <div class="empty-state">
        <div class="empty-state-icon">📂</div>
        <div class="empty-state-title">Chưa có dự án nào</div>
        <p class="empty-state-desc" style="margin-bottom:16px">Tạo dự án đầu tiên ngay!</p>
        <a href="{{ url_for('project_add') }}" class="btn btn-primary btn-sm">＋ Tạo dự án</a>
      </div>
      {% endif %}
    </div>
  </div>

  <!-- Nhiệm vụ của tôi -->
  <div class="card">
    <div class="card-header">
      <span class="card-title">✅ Nhiệm vụ của tôi</span>
      <a href="{{ url_for('tasks_page') }}" class="btn btn-outline btn-sm">Xem tất cả</a>
    </div>
    <div class="card-body">
      {% if my_tasks %}
      <div class="task-list">
        {% for t in my_tasks %}
        <div class="task-item">
          <div class="task-check {{ t.trang_thai }}">
            {% if t.trang_thai == 'xong' %}✓{% elif t.trang_thai == 'dang_lam' %}⟳{% endif %}
          </div>
          <div class="task-info">
            <div class="task-name {{ t.trang_thai }}">{{ t.ten_nhiem_vu }}</div>
            <div class="task-project">📁 {{ t.ten_du_an }}</div>
          </div>
          {% if t.deadline %}
          <span class="task-deadline">📅 {{ t.deadline }}</span>
          {% endif %}
        </div>
        {% endfor %}
      </div>
      {% else %}
      <div class="empty-state">
        <div class="empty-state-icon">🎉</div>
        <div class="empty-state-title">Không có nhiệm vụ!</div>
        <p class="empty-state-desc">Bạn chưa được phân công nhiệm vụ nào.</p>
      </div>
      {% endif %}
    </div>
  </div>

</div>

<!--  BANNER AI  -->
<div style="margin-top:24px;padding:20px 24px;
            background:linear-gradient(135deg,rgba(108,99,255,.15),rgba(67,233,123,.08));
            border:1px solid rgba(108,99,255,.25);border-radius:var(--radius-lg);
            display:flex;align-items:center;gap:16px">
  <span style="font-size:36px">🤖</span>
  <div>
    <div style="font-weight:700;font-size:15px">Tính năng AI gợi ý nhiệm vụ – Tuần 5</div>
    <div style="font-size:13px;color:var(--text-muted);margin-top:3px">
      Nhập mô tả dự án → AI tự động tạo danh sách nhiệm vụ. Biểu đồ tiến độ ra mắt Tuần 6!
    </div>
  </div>
  <span class="badge badge-dang_lam" style="margin-left:auto;white-space:nowrap">Đang phát triển</span>
</div>

{% endblock %}

{% block extra_js %}
<script>
window.addEventListener('load', function() {
  document.querySelectorAll('.progress-bar-fill').forEach(function(b) {
    var w = b.style.width; b.style.width = '0';
    setTimeout(function() { b.style.width = w; }, 200);
  });
});
</script>
{% endblock %}




