{% extends "layout.html" %}
{% block title %}{{ project.ten_du_an }}{% endblock %}

{% block content %}

<!--  BREADCRUMB  -->
<div style="display:flex;align-items:center;gap:8px;font-size:13px;
            color:var(--text-muted);margin-bottom:20px">
  <a href="{{ url_for('projects_list') }}"
     style="color:var(--primary-light);text-decoration:none">📁 Dự án</a>
  <span>›</span>
  <span style="color:var(--text-white)">{{ project.ten_du_an }}</span>
</div>

<!--  TOPBAR  -->
<div class="topbar">
  <div>
    <h1 class="page-title">{{ project.ten_du_an }}</h1>
    <p class="page-subtitle">
      👤 {{ ten_nguoi_tao }}
      {% if project.ngay_bat_dau %} &nbsp;·&nbsp; 🗓 {{ project.ngay_bat_dau }}{% endif %}
      {% if project.ngay_ket_thuc %} → {{ project.ngay_ket_thuc }}{% endif %}
    </p>
  </div>
  <div style="display:flex;gap:8px">
    <a href="{{ url_for('task_add', project_id=project.id) }}"
       class="btn btn-primary" id="btn-add-task-detail">
      ＋ Thêm nhiệm vụ
    </a>
    <a href="{{ url_for('project_edit', project_id=project.id) }}"
       class="btn btn-outline">✏️ Sửa dự án</a>
    <form method="POST" action="{{ url_for('project_delete', project_id=project.id) }}"
          onsubmit="return confirm('Xac nhan xoa du an nay?\nToan bo nhiem vu cung se bi xoa!')">
      <button type="submit" class="btn btn-danger">🗑️</button>
    </form>
  </div>
</div>

<!--  THỐNG KÊ NHANH  -->
<div class="stats-grid" style="grid-template-columns:repeat(4,1fr);margin-bottom:24px">
  <div class="stat-card blue">
    <div class="stat-icon">📋</div>
    <div class="stat-value">{{ tong }}</div>
    <div class="stat-label">Tổng nhiệm vụ</div>
  </div>
  <div class="stat-card green">
    <div class="stat-icon">✅</div>
    <div class="stat-value">{{ xong }}</div>
    <div class="stat-label">Đã xong</div>
  </div>
  <div class="stat-card purple">
    <div class="stat-icon">▶</div>
    <div class="stat-value">{{ dang }}</div>
    <div class="stat-label">Đang làm</div>
  </div>
  <div class="stat-card pink">
    <div class="stat-icon">⏸</div>
    <div class="stat-value">{{ chua }}</div>
    <div class="stat-label">Chưa làm</div>
  </div>
</div>

<!--  THANH TIẾN ĐỘ TỔNG  -->
<div class="card" style="margin-bottom:24px">
  <div class="card-body" style="padding:16px 22px">
    <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:8px">
      <span style="font-size:14px;font-weight:600">📊 Tiến độ tổng thể</span>
      <span style="font-size:24px;font-weight:800;color:var(--primary-light)">{{ pct }}%</span>
    </div>
    <div class="progress-bar-bg" style="height:10px">
      <div class="progress-bar-fill" style="width:{{ pct }}%;height:10px"></div>
    </div>
    {% if project.mo_ta %}
    <p style="font-size:13px;color:var(--text-muted);margin-top:10px;margin-bottom:0">
      📝 {{ project.mo_ta }}
    </p>
    {% endif %}
  </div>
</div>

<!--  DANH SÁCH NHIỆM VỤ  -->
<div class="card">
  <div class="card-header">
    <span class="card-title">✅ Danh sách nhiệm vụ</span>
    <a href="{{ url_for('task_add', project_id=project.id) }}"
       class="btn btn-primary btn-sm">＋ Thêm</a>
  </div>

  {% if tasks %}
  <div class="table-wrapper">
    <table id="tasks-table">
      <thead>
        <tr>
          <th>Trạng thái</th>
          <th>Tên nhiệm vụ</th>
          <th>Người phụ trách</th>
          <th>Deadline</th>
          <th>Hành động</th>
        </tr>
      </thead>
      <tbody>
        {% for t in tasks %}
        <tr id="row-{{ t.id }}">
          <td>
            <!-- Dropdown đổi trạng thái nhanh -->
            <select class="status-select"
                    data-id="{{ t.id }}"
                    onchange="updateStatus({{ t.id }}, this.value)"
                    style="background:transparent;border:none;font-size:12px;
                           font-weight:600;cursor:pointer;outline:none;
                           padding:4px 6px;border-radius:99px;">
              <option value="chua_lam" {% if t.trang_thai == 'chua_lam' %}selected{% endif %}
                      style="background:#1a1927">⏸ Chưa làm</option>
              <option value="dang_lam" {% if t.trang_thai == 'dang_lam' %}selected{% endif %}
                      style="background:#1a1927">▶ Đang làm</option>
              <option value="xong"     {% if t.trang_thai == 'xong'     %}selected{% endif %}
                      style="background:#1a1927">✅ Xong</option>
            </select>
          </td>
          <td>
            <div style="font-weight:600;font-size:13px
                        {% if t.trang_thai == 'xong' %};text-decoration:line-through;
                        color:var(--text-muted){% endif %}" id="name-{{ t.id }}">
              {{ t.ten_nhiem_vu }}
            </div>
            {% if t.mo_ta %}
            <div style="font-size:11px;color:var(--text-muted);margin-top:2px">
              {{ t.mo_ta[:60] }}{% if t.mo_ta|length > 60 %}...{% endif %}
            </div>
            {% endif %}
          </td>
          <td>
            {% if t.ten_phu_trach %}
            <div style="display:flex;align-items:center;gap:6px">
              <div style="width:26px;height:26px;border-radius:50%;
                          background:linear-gradient(135deg,var(--primary),var(--secondary));
                          display:grid;place-items:center;font-size:12px;font-weight:700">
                {{ t.ten_phu_trach[0] | upper }}
              </div>
              <span style="font-size:13px">{{ t.ten_phu_trach }}</span>
            </div>
            {% else %}
            <span style="font-size:12px;color:var(--text-sub)">— Chưa phân công</span>
            {% endif %}
          </td>
          <td>
            {% if t.deadline %}
            <span class="task-deadline {% if t.deadline < today and t.trang_thai != 'xong' %}overdue{% endif %}">
              📅 {{ t.deadline }}
            </span>
            {% else %}
            <span style="color:var(--text-sub);font-size:12px">—</span>
            {% endif %}
          </td>
          <td>
            <div style="display:flex;gap:6px">
              <a href="{{ url_for('task_edit', task_id=t.id) }}"
                 class="btn btn-outline btn-sm" title="Sửa nhiệm vụ">✏️</a>
              <form method="POST" action="{{ url_for('task_delete', task_id=t.id) }}"
                    onsubmit="return confirm('Xac nhan xoa nhiem vu nay?')">
                <button type="submit" class="btn btn-danger btn-sm" title="Xóa">🗑️</button>
              </form>
            </div>
          </td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>

  {% else %}
  <div class="card-body">
    <div class="empty-state" style="padding:48px">
      <div class="empty-state-icon">📭</div>
      <div class="empty-state-title">Dự án này chưa có nhiệm vụ nào</div>
      <p class="empty-state-desc" style="margin-bottom:20px">
        Thêm nhiệm vụ đầu tiên để bắt đầu theo dõi tiến độ
      </p>
      <a href="{{ url_for('task_add', project_id=project.id) }}"
         class="btn btn-primary">＋ Thêm nhiệm vụ đầu tiên</a>
    </div>
  </div>
  {% endif %}
</div>

{% endblock %}

{% block extra_js %}
<script>
var today = "{{ today }}";

// Tô màu select theo trạng thái
function colorSelect(sel) {
  var colors = {
    chua_lam: 'rgba(255,255,255,.1)',
    dang_lam: 'rgba(255,209,102,.15)',
    xong:     'rgba(67,233,123,.15)'
  };
  var textColors = {
    chua_lam: 'var(--text-muted)',
    dang_lam: 'var(--warning)',
    xong:     'var(--accent)'
  };
  sel.style.background = colors[sel.value] || colors.chua_lam;
  sel.style.color = textColors[sel.value] || textColors.chua_lam;
}

document.querySelectorAll('.status-select').forEach(colorSelect);

// Đổi trạng thái nhanh qua AJAX
function updateStatus(taskId, status) {
  var form = new FormData();
  form.append('trang_thai', status);

  fetch('/nhiem-vu/' + taskId + '/trang-thai', { method:'POST', body: form })
    .then(function(r) { return r.json(); })
    .then(function(data) {
      if (data.ok) {
        // Tô màu select
        var sel = document.querySelector('.status-select[data-id="' + taskId + '"]');
        if (sel) colorSelect(sel);
        // Gạch tên nếu xong
        var nameEl = document.getElementById('name-' + taskId);
        if (nameEl) {
          if (status === 'xong') {
            nameEl.style.textDecoration = 'line-through';
            nameEl.style.color = 'var(--text-muted)';
          } else {
            nameEl.style.textDecoration = '';
            nameEl.style.color = '';
          }
        }
      }
    });
}

// Progress bar animation
window.addEventListener('load', function() {
  document.querySelectorAll('.progress-bar-fill').forEach(function(b) {
    var w = b.style.width; b.style.width = '0';
    setTimeout(function() { b.style.width = w; }, 200);
  });
});
</script>
{% endblock %}







