<!DOCTYPE html>
<html lang="vi">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{% block title %}TaskFlow{% endblock %} | Quản Lý Dự Án</title>
  <meta name="description" content="Hệ thống quản lý dự án nhóm thông minh – Nhóm 02" />
