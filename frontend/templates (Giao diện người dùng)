{% extends "layout.html" %}
{% block title %}{% if action == 'add' %}Thêm nhiệm vụ{% else %}Sửa nhiệm vụ{% endif %}{% endblock %}

{% block content %}

<!--  TOPBAR  -->
<div class="topbar">
  <div>
    <h1 class="page-title">
      {% if action == 'add' %}➕ Thêm <span>nhiệm vụ mới</span>
      {% else %}✏️ Sửa <span>nhiệm vụ</span>{% endif %}
    </h1>
    <p class="page-subtitle">
      {% if action == 'add' %}Phân công công việc cho thành viên nhóm
      {% else %}Cập nhật thông tin nhiệm vụ "{{ task.ten_nhiem_vu }}"{% endif %}
    </p>
  </div>
  {% if project_id %}
  <a href="{{ url_for('project_detail', project_id=project_id) }}"
     class="btn btn-outline">← Quay lại dự án</a>
  {% else %}
  <a href="{{ url_for('tasks_page') }}" class="btn btn-outline">← Quay lại</a>
  {% endif %}
</div>

<!--  FORM  -->
<div style="display:grid;grid-template-columns:1fr 340px;gap:24px;align-items:start">

  <!-- CỘT TRÁI: Form chính -->
  <div class="card">
    <div class="card-header">
      <span class="card-title">📝 Thông tin nhiệm vụ</span>
    </div>
    <div class="card-body">
      <form method="POST"
            action="{% if action == 'add' %}
                      {% if project_id %}{{ url_for('task_add', project_id=project_id) }}
                      {% else %}{{ url_for('task_add') }}{% endif %}
                    {% else %}{{ url_for('task_edit', task_id=task.id) }}{% endif %}"
            id="task-form" novalidate>

        <!-- Tên nhiệm vụ -->
        <div class="form-group">
          <label class="form-label" for="ten_nhiem_vu">
            ✅ Tên nhiệm vụ <span style="color:var(--danger)">*</span>
          </label>
          <input type="text" id="ten_nhiem_vu" name="ten_nhiem_vu"
                 class="form-control"
                 placeholder="VD: Thiết kế màn hình đăng nhập..."
                 value="{{ task.ten_nhiem_vu if action == 'edit' else '' }}"
                 required maxlength="200" />
        </div>

        <!-- Mô tả nhiệm vụ -->
        <div class="form-group">
          <label class="form-label" for="mo_ta">📝 Mô tả chi tiết</label>
          <textarea id="mo_ta" name="mo_ta" class="form-control"
                    rows="3"
                    placeholder="Mô tả yêu cầu, kết quả mong đợi..."
                    style="resize:vertical">{{ task.mo_ta if action == 'edit' else '' }}</textarea>
        </div>

        <!-- Dự án thuộc -->
        <div class="form-group">
          <label class="form-label" for="du_an_id">
            📁 Thuộc dự án <span style="color:var(--danger)">*</span>
          </label>
          <select id="du_an_id" name="du_an_id" class="form-control" required>
            <option value="">— Chọn dự án —</option>
            {% for p in projects %}
            <option value="{{ p.id }}"
              {% if action == 'edit' and task.du_an_id == p.id %}selected
              {% elif project_id and project_id == p.id %}selected
              {% endif %}>
              {{ p.ten_du_an }}
            </option>
            {% endfor %}
          </select>
        </div>

        <!-- Người phụ trách & Trạng thái (2 cột) -->
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:14px">

          <div class="form-group">
            <label class="form-label" for="phu_trach">👤 Người phụ trách</label>
            <select id="phu_trach" name="phu_trach" class="form-control">
              <option value="">— Chưa phân công —</option>
              {% for u in users %}
              <option value="{{ u.id }}"
                {% if action == 'edit' and task.phu_trach == u.id %}selected{% endif %}>
                {{ u.ten }}
              </option>
              {% endfor %}
            </select>
          </div>

          <div class="form-group">
            <label class="form-label" for="trang_thai">🔖 Trạng thái</label>
            <select id="trang_thai" name="trang_thai" class="form-control"
                    onchange="colorStatusSelect(this)">
              <option value="chua_lam"
                {% if action == 'edit' and task.trang_thai == 'chua_lam' %}selected
                {% elif action == 'add' %}selected{% endif %}>
                ⏸ Chưa làm
              </option>
              <option value="dang_lam"
                {% if action == 'edit' and task.trang_thai == 'dang_lam' %}selected{% endif %}>
                ▶ Đang làm
              </option>
              <option value="xong"
                {% if action == 'edit' and task.trang_thai == 'xong' %}selected{% endif %}>
                ✅ Xong
              </option>
            </select>
          </div>
        </div>

        <!-- Deadline -->
        <div class="form-group">
          <label class="form-label" for="deadline">⏰ Deadline (hạn nộp)</label>
          <input type="date" id="deadline" name="deadline"
                 class="form-control"
                 value="{{ task.deadline if action == 'edit' else '' }}"
                 min="{{ today }}" />
          <span style="font-size:11px;color:var(--text-sub);margin-top:4px;display:block">
            Để trống nếu không có hạn cụ thể
          </span>
        </div>

        <!-- Submit -->
        <div style="display:flex;gap:10px;margin-top:8px">
          <button type="submit" class="btn btn-primary"
                  style="flex:1;justify-content:center;padding:13px">
            {% if action == 'add' %}➕ Thêm nhiệm vụ{% else %}💾 Lưu thay đổi{% endif %}
          </button>
          {% if project_id %}
          <a href="{{ url_for('project_detail', project_id=project_id) }}"
             class="btn btn-outline" style="padding:13px 20px">Hủy</a>
          {% else %}
          <a href="{{ url_for('tasks_page') }}" class="btn btn-outline"
             style="padding:13px 20px">Hủy</a>
          {% endif %}
        </div>

      </form>
    </div>
  </div>

  <!-- CỘT PHẢI: Hướng dẫn -->
  <div style="display:flex;flex-direction:column;gap:16px">

    <!-- Ý nghĩa trạng thái -->
    <div class="card">
      <div class="card-header">
        <span class="card-title">🔖 Ý nghĩa trạng thái</span>
      </div>
      <div class="card-body" style="padding:14px">
        <div style="display:flex;flex-direction:column;gap:10px;font-size:13px">
          <div style="display:flex;gap:10px;align-items:flex-start">
            <span class="badge badge-chua_lam" style="flex-shrink:0">⏸ Chưa làm</span>
            <span style="color:var(--text-muted)">Công việc chưa được bắt đầu</span>
          </div>
          <div style="display:flex;gap:10px;align-items:flex-start">
            <span class="badge badge-dang_lam" style="flex-shrink:0">▶ Đang làm</span>
            <span style="color:var(--text-muted)">Đang trong quá trình thực hiện</span>
          </div>
          <div style="display:flex;gap:10px;align-items:flex-start">
            <span class="badge badge-xong" style="flex-shrink:0">✅ Xong</span>
            <span style="color:var(--text-muted)">Hoàn thành, được tính vào tiến độ</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Gợi ý đặt tên -->
    <div class="card">
      <div class="card-header">
        <span class="card-title">💡 Gợi ý tên nhiệm vụ</span>
      </div>
      <div class="card-body" style="padding:14px">
        <div style="display:flex;flex-direction:column;gap:6px;font-size:12px;
                    color:var(--text-muted)">
          <div>✅ Thiết kế màn hình đăng nhập</div>
          <div>✅ Viết API endpoint GET /users</div>
          <div>✅ Kiểm thử chức năng tìm kiếm</div>
          <div>✅ Sửa lỗi hiển thị trên mobile</div>
          <div>✅ Chuẩn bị dữ liệu mẫu CSV</div>
          <div style="margin-top:8px;color:var(--danger)">❌ Làm việc (quá chung chung)</div>
          <div style="color:var(--danger)">❌ Fix bug (không rõ bug nào)</div>
        </div>
      </div>
    </div>

    <!-- Tip deadline -->
    <div style="padding:14px;background:rgba(255,209,102,.08);
                border:1px solid rgba(255,209,102,.2);border-radius:12px;
                font-size:12px;color:var(--text-muted)">
      ⏰ <strong style="color:var(--warning)">Mẹo đặt deadline:</strong><br/>
      Đặt deadline sớm hơn thực tế 1–2 ngày để có thời gian review và sửa lỗi trước khi nộp.
    </div>

  </div>
</div>

{% endblock %}

{% block extra_js %}
<script>
function colorStatusSelect(sel) {
  var bg = { chua_lam:'rgba(255,255,255,.08)', dang_lam:'rgba(255,209,102,.15)', xong:'rgba(67,233,123,.12)' };
  sel.style.background = bg[sel.value] || bg.chua_lam;
}
// Init
var statusSel = document.getElementById('trang_thai');
if (statusSel) colorStatusSelect(statusSel);
</script>
{% endblock %}





