{% extends "layout.html" %}
{% block title %}Quản lý công việc{% endblock %}

{% block content %}

<div class="topbar">
  <div>
    <h1 class="page-title">Quản lý <span>công việc</span></h1>
    <p class="page-subtitle">Tất cả nhiệm vụ trong các dự án ({{ tasks|length }} nhiệm vụ)</p>
  </div>
  <a href="{{ url_for('task_add') }}" class="btn btn-primary" id="btn-add-task">
    ＋ Thêm nhiệm vụ
  </a>
</div>

<!--  BỘ LỌC & TÌM KIẾM  -->
<div style="display:flex;gap:10px;margin-bottom:20px;flex-wrap:wrap;align-items:center">
  <div style="display:flex;gap:8px;flex-wrap:wrap">
    <button class="btn btn-outline btn-sm filter-btn active" onclick="filterTasks('all',this)">
      📋 Tất cả <span style="margin-left:4px;padding:1px 6px;background:rgba(255,255,255,.1);border-radius:99px;font-size:10px">{{ tasks|length }}</span>
    </button>
    <button class="btn btn-outline btn-sm filter-btn" onclick="filterTasks('chua_lam',this)">
      ⏸ Chưa làm
    </button>
    <button class="btn btn-outline btn-sm filter-btn" onclick="filterTasks('dang_lam',this)">
      ▶ Đang làm
    </button>
    <button class="btn btn-outline btn-sm filter-btn" onclick="filterTasks('xong',this)">
      ✅ Xong
    </button>
  </div>
  <div style="margin-left:auto">
    <input type="text" class="form-control" id="search-task"
           placeholder="🔍 Tìm kiếm..."
           style="width:220px;padding:8px 14px;font-size:13px"
           oninput="searchTasks(this.value)" />
  </div>
</div>

<!--  BẢNG NHIỆM VỤ  -->
<div class="card">
  <div class="card-header">
    <span class="card-title">📋 Danh sách nhiệm vụ</span>
    <a href="{{ url_for('project_add') }}" class="btn btn-outline btn-sm">＋ Dự án mới</a>
  </div>

  {% if tasks %}
  <div class="table-wrapper">
    <table id="tasks-table">
      <thead>
        <tr>
          <th>Trạng thái</th>
          <th>Tên nhiệm vụ</th>
          <th>Dự án</th>
          <th>Người phụ trách</th>
          <th>Deadline</th>
          <th>Hành động</th>
        </tr>
      </thead>
      <tbody>
        {% for t in tasks %}
        <tr class="task-row" data-status="{{ t.trang_thai }}"
            data-name="{{ t.ten_nhiem_vu | lower }}">
          <td>
            <select class="status-sel" data-id="{{ t.id }}"
                    onchange="quickStatus({{ t.id }}, this)"
                    style="background:transparent;border:none;font-size:12px;
                           font-weight:600;cursor:pointer;padding:4px 6px;
                           border-radius:99px;outline:none">
              <option value="chua_lam" {% if t.trang_thai=='chua_lam' %}selected{% endif %}
                      style="background:#1a1927">⏸ Chưa làm</option>
              <option value="dang_lam" {% if t.trang_thai=='dang_lam' %}selected{% endif %}
                      style="background:#1a1927">▶ Đang làm</option>
              <option value="xong"     {% if t.trang_thai=='xong'     %}selected{% endif %}
                      style="background:#1a1927">✅ Xong</option>
            </select>
          </td>
          <td>
            <div class="task-name-cell" data-id="{{ t.id }}"
                 style="font-weight:600;font-size:13px
                 {% if t.trang_thai == 'xong' %};text-decoration:line-through;color:var(--text-muted){% endif %}">
              {{ t.ten_nhiem_vu }}
            </div>
            {% if t.mo_ta %}
            <div style="font-size:11px;color:var(--text-muted);margin-top:2px">
              {{ t.mo_ta[:50] }}{% if t.mo_ta|length > 50 %}...{% endif %}
            </div>
            {% endif %}
          </td>
          <td>
            <a href="{{ url_for('project_detail', project_id=t.du_an_id) }}"
               style="font-size:12px;padding:3px 10px;background:rgba(108,99,255,.12);
                      border-radius:99px;color:var(--primary-light);text-decoration:none;
                      display:inline-block">
              📁 {{ t.ten_du_an }}
            </a>
          </td>
          <td>
            {% if t.ten_phu_trach %}
            <div style="display:flex;align-items:center;gap:6px">
              <div style="width:24px;height:24px;border-radius:50%;
                          background:linear-gradient(135deg,var(--primary),var(--secondary));
                          display:grid;place-items:center;font-size:11px;font-weight:700">
                {{ t.ten_phu_trach[0]|upper }}
              </div>
              <span style="font-size:13px">{{ t.ten_phu_trach }}</span>
            </div>
            {% else %}
            <span style="color:var(--text-sub);font-size:12px">— Chưa phân công</span>
            {% endif %}
          </td>
          <td>
            {% if t.deadline %}
            <span class="task-deadline">📅 {{ t.deadline }}</span>
            {% else %}
            <span style="color:var(--text-sub);font-size:12px">—</span>
            {% endif %}
          </td>
          <td>
            <div style="display:flex;gap:6px">
              <a href="{{ url_for('task_edit', task_id=t.id) }}"
                 class="btn btn-outline btn-sm" title="Sửa nhiệm vụ">✏️</a>
              <form method="POST" action="{{ url_for('task_delete', task_id=t.id) }}"
                    onsubmit="return confirm('Xac nhan xoa nhiem vu nay?')">
                <button type="submit" class="btn btn-danger btn-sm" title="Xóa">🗑️</button>
              </form>
            </div>
          </td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>

  {% else %}
  <div class="card-body">
    <div class="empty-state" style="padding:64px 24px">
      <div class="empty-state-icon">📭</div>
      <div class="empty-state-title">Chưa có nhiệm vụ nào</div>
      <p class="empty-state-desc" style="margin-bottom:20px">
        Tạo dự án trước, rồi thêm nhiệm vụ vào từng dự án.
      </p>
      <div style="display:flex;gap:10px;justify-content:center">
        <a href="{{ url_for('project_add') }}" class="btn btn-primary">＋ Tạo dự án</a>
        <a href="{{ url_for('task_add') }}" class="btn btn-outline">＋ Thêm nhiệm vụ</a>
      </div>
    </div>
  </div>
  {% endif %}
</div>

{% endblock %}

{% block extra_js %}
<script>
// Lọc theo trạng thái
function filterTasks(status, btn) {
  document.querySelectorAll('.filter-btn').forEach(b => b.classList.remove('active'));
  btn.classList.add('active');
  document.querySelectorAll('.task-row').forEach(r => {
    r.style.display = (status === 'all' || r.dataset.status === status) ? '' : 'none';
  });
}

// Tìm kiếm
function searchTasks(q) {
  var lower = q.toLowerCase();
  document.querySelectorAll('.task-row').forEach(r => {
    r.style.display = r.dataset.name.includes(lower) ? '' : 'none';
  });
}

// Đổi trạng thái nhanh
function colorSel(sel) {
  var bg = {chua_lam:'rgba(255,255,255,.08)',dang_lam:'rgba(255,209,102,.15)',xong:'rgba(67,233,123,.12)'};
  var cl = {chua_lam:'var(--text-muted)',dang_lam:'var(--warning)',xong:'var(--accent)'};
  sel.style.background = bg[sel.value];
  sel.style.color      = cl[sel.value];
}

document.querySelectorAll('.status-sel').forEach(colorSel);

function quickStatus(id, sel) {
  var form = new FormData();
  form.append('trang_thai', sel.value);
  fetch('/nhiem-vu/' + id + '/trang-thai', {method:'POST', body:form})
    .then(r => r.json()).then(d => {
      if (d.ok) {
        colorSel(sel);
        var row = sel.closest('.task-row');
        row.dataset.status = d.trang_thai;
        var nameEl = row.querySelector('.task-name-cell');
        if (nameEl) {
          nameEl.style.textDecoration = d.trang_thai === 'xong' ? 'line-through' : '';
          nameEl.style.color = d.trang_thai === 'xong' ? 'var(--text-muted)' : '';
        }
      }
    });
}
</script>
{% endblock %}
